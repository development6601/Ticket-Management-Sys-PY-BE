# ==========================================
# Service Operations - Environment Variables
# ==========================================

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
# Set to True on Render/Staging to return verification/reset/setup tokens in API responses for QA testing
EXPOSE_TEST_TOKENS=False

# PostgreSQL Database Configuration
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

DB_NAME=service_operations
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
